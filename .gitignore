.DS_Store
*.swp
*.swo
.idea/
.vscode/
node_modules/

# Dogfooding artifacts — when iterating on this plugin via its own workflow,
# prep.sh seeds .flow/tasks/<date>-<task>/ with task-local working memory
# (brief.md, prepare.md, plan.md, tasks.md, artifacts/, logs, secrets).
# It is gitignored in every consumer project too — the durable copy of
# non-code docs lives in GitHub Issues / PR bodies. Note only tasks/ is
# ignored: .flow/config.yaml is per-project config and stays committed.
# (prep.sh also drops a self-ignoring `*` .gitignore inside each task dir.)
.flow/tasks/

# Pre-2.2.0 name for the same thing. Kept so leftover local dirs from an
# older session can't be accidentally committed. Safe to drop later.
.planning/

# Multi-LLM dispatch diagnostic runlogs (regenerable from CLI re-runs)
# Per references/multi-llm.md: stdout/stderr/exit are captured as diagnostic
# runlogs alongside the actual review file. The review (code-*.md) is the
# audit artifact and stays in git; runlogs are noise.
_runlog-*
